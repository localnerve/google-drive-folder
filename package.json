{
  "name": "@localnerve/google-drive-folder",
  "version": "20.0.1",
  "description": "Stream files from a Google Drive folder",
  "type": "module",
  "main": "./cjs/index.cjs",
  "module": "./index.js",
  "types": "./index.js",
  "exports": {
    "types": "./index.js",
    "import": "./index.js",
    "require": "./cjs/index.cjs",
    "default": "./index.js"
  },
  "scripts": {
    "lint": "eslint .",
    "test:package": "node ./__test-package__/index.js",
    "test": "npm run test:unit && npm run test:package",
    "test:unit": "c8 node --test --experimental-test-module-mocks \"__tests__/**/*.test.js\"",
    "pretranspile": "node -e \"require('fs').rmSync('./cjs',{recursive:true,force:true})\"",
    "transpile": "babel index.js -o ./cjs/index.cjs && babel ./lib --out-dir ./cjs/lib",
    "posttranspile": "node posttranspile.js",
    "prepublishOnly": "npm run transpile"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/localnerve/google-drive-folder.git"
  },
  "author": "Alex Grant <alex@localnerve.com> (https://www.localnerve.com)",
  "maintainers": [
    {
      "name": "localnerve",
      "email": "alex@localnerve.com",
      "url": "https://github.com/localnerve"
    }
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/localnerve/google-drive-folder/issues"
  },
  "homepage": "https://github.com/localnerve/google-drive-folder#readme",
  "devDependencies": {
    "@babel/cli": "^8.0.6",
    "@babel/preset-env": "^8.0.6",
    "@eslint/js": "^10.0.1",
    "c8": "^12.0.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "micromark": "^4.0.3",
    "micromark-extension-directive": "^4.0.0",
    "tar": "^7.5.22"
  },
  "dependencies": {
    "@googleapis/drive": "^26.0.1"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/localnerve"
    },
    {
      "type": "paypal",
      "url": "https://www.paypal.com/ncp/payment/DHCB5GUYMGX5U"
    }
  ],
  "engines": {
    "node": ">=22"
  }
}
